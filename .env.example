# ==============================================================================
# AI-Powered Smart Training & Placement Automation Portal
# Environment Variables Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTES:
# 1. Never commit real keys or secrets to version control.
# 2. Only variables prefixed with VITE_ are exposed to the client-side browser bundle.
# 3. Never put Gmail app passwords, service-role keys, or private API keys in VITE_* variables.
# ==============================================================================

# Supabase Client Configuration (Client-side / Browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional / Server-side keys (Only if using an external backend service, never in browser)
# SUPABASE_SERVICE_ROLE_KEY=
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=465
# GMAIL_SMTP_USERNAME=
# GMAIL_SMTP_APP_PASSWORD=
